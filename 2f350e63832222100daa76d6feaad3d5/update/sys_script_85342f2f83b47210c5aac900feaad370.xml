        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    var edgeList = JSON.parse(current.edge_payload);
    var matchedResults = [];
    var matchedEdge;
    var matchedLink;
    for (var j = 0; j < edgeList.length; j++) {
        var edge = edgeList[j];
        if (!edge.links) continue;

        for (var k = 0; k < edge.links.length; k++) {
            var link = edge.links[k];
            matchedEdge = edge;
            matchedLink = link;
            if (matchedEdge && matchedLink) {
                matchedResults.push({
                    ip: link.ipAddress,
                    hostname: matchedEdge.dnsName || matchedEdge.name || matchedEdge.deviceId || "Unknown",
                    lat: matchedLink.lat,
                    lng: matchedLink.lon
                });
            }
        }
    }
    if (matchedResults)
        current.ips_lat_lon_host = JSON.stringify(matchedResults);
    else
        current.ips_lat_lon_host = "";
})(current, previous);]]></script>
